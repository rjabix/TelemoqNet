// Include orphan data even when no final marker was submitted.
union HoneypotSessions_CL, HoneypotLogins_CL, HoneypotCommands_CL,
      HoneypotEvents_CL, HoneypotPayloadChunks_CL, HoneypotImportStatus_CL
| summarize arg_max(TimeGenerated, ExpectedRows, SessionId) by SourceBlob, SourceETag, ImportRunId, EntityKind, RecordIndex, ChunkIndex
| summarize ActualRows=countif(EntityKind != 'ImportStatus'),
            ExpectedRows=maxif(ExpectedRows, EntityKind == 'ImportStatus'),
            Markers=countif(EntityKind == 'ImportStatus'),
            TimeGenerated=max(TimeGenerated), SessionId=take_any(SessionId)
    by SourceBlob, SourceETag, ImportRunId
| extend Delivery=case(
    Markers > 0 and ActualRows == ExpectedRows, 'Complete',
    TimeGenerated >= ago(15m), 'Awaiting delivery',
    Markers == 0, 'Orphan: missing status marker', 'Stale partial delivery')
| project TimeGenerated, ImportRunId, SessionId, SourceBlob, SourceETag, ExpectedRows, ActualRows, Delivery
| order by TimeGenerated desc
| take 500
