HoneypotRows()
| where EntityKind == 'Sessions'
| project StartedAt, SessionId, Protocol, RemoteEndpoint=tostring(Payload.RemoteEndpoint),
          SourceAddress, Country, City, Latitude, Longitude,
          Username=tostring(Payload.Username), AuthenticationSucceeded,
          DisconnectReason=tostring(Payload.DisconnectReason), HasChunks
| order by StartedAt desc
| take 500
