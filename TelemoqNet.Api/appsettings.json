{
  "Honeypot": {
    "TelnetPort": 2323,
    "MaxConnections": 100,
    "SessionTimeoutSeconds": 300,
    "MaxLineLength": 2048,
    "MaxPacketSize": 8192,
    "MaxResponseLength": 16384,
    "CommandLatencyMilliseconds": 25,
    "AuthenticationRetryDelayMilliseconds": 250,
    "MaxAuthenticationAttempts": 3,
    "CloseOnAuthenticationFailure": true,
    "CapturePasswords": false,
    "Device": "GenericLinux",
    "Banner": "BusyBox v1.19.4 (2014-06-12 08:23:17 UTC)",
    "Hostname": "router",
    "Credentials": [
      "admin:admin",
      "root:root",
      "root:123456",
      "admin:1234"
    ],
    "Mqtt": {
      "Enabled": true,
      "Port": 1883,
      "MaxConnections": 100,
      "MaxConnectionsPerIp": 10,
      "ConnectTimeoutSeconds": 10,
      "MaxSessionLifetimeSeconds": 3600,
      "MaxPacketSize": 65536,
      "MaxSubscriptionsPerSession": 32,
      "MaxTopicLevels": 32,
      "PayloadCaptureBytes": 1024,
      "MaxEventsPerSession": 500,
      "OutboundQueueLength": 64,
      "AllowAnonymous": true,
      "BrokerProfile": "SmartHome",
      "SysIntervalSeconds": 10
    }
  },
  "AzureStorage": {
    "Container": "honeypot-sessions"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}